{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "expgov.config.ts",
    "tests/fixtures/**",
    "tests/publish-types/fixture/**",
    "examples/sdk/**",
    "i18nprune.config.ts",
    "scripts/dev/pathAliases.d.mts",
    "apps/workers/**/public/**",
    "apps/*/functions/**"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["rg"],
  "workspaces": {
    "packages/core": {
      "entry": ["src/**/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/cli": {
      "entry": ["src/**/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/landing": {
      "entry": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@cloudflare/workers-types"]
    },
    "apps/web": {
      "entry": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@cloudflare/workers-types"]
    },
    "apps/report": {
      "entry": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@cloudflare/workers-types"]
    },
    "apps/docs": {
      "entry": ["content/**/*.md", ".vitepress/**/*.{ts,mts}"],
      "ignoreDependencies": ["@cloudflare/workers-types"]
    },
    "apps/releases": {
      "entry": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"],
      "ignoreDependencies": ["@cloudflare/workers-types"]
    },
    "apps/git": {
      "entry": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"],
      "ignoreDependencies": ["@cloudflare/workers-types"]
    },
    "apps/extension": {
      "project": ["src/extension/**/*.ts"]
    },
    "apps/extension/src/webview": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/ui": {
      "entry": ["src/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/seo": {
      "entry": ["src/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
