{
  "name": "i18nprune",
  "version": "1.1.0",
  "description": "Production-grade i18n toolkit. CLI + stable programmatic API for validation, sync, pruning, generation and quality control of translation files.",
  "homepage": "https://docs.i18nprune.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zamdevio/i18nprune.git"
  },
  "bugs": {
    "url": "https://github.com/zamdevio/i18nprune/issues"
  },
  "type": "module",
  "bin": {
    "i18nprune": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./core/config": {
      "types": "./dist/core/config.d.ts",
      "import": "./dist/core/config.js",
      "default": "./dist/core/config.js"
    },
    "./core/runtime/node": {
      "types": "./dist/core/runtime/node.d.ts",
      "import": "./dist/core/runtime/node.js",
      "default": "./dist/core/runtime/node.js"
    },
    "./core/runtime/web": {
      "types": "./dist/core/runtime/web.d.ts",
      "import": "./dist/core/runtime/web.js",
      "default": "./dist/core/runtime/web.js"
    },
    "./core/runtime/edge": {
      "types": "./dist/core/runtime/edge.d.ts",
      "import": "./dist/core/runtime/edge.js",
      "default": "./dist/core/runtime/edge.js"
    },
    "./report": {
      "types": "./dist/report.d.ts",
      "import": "./dist/report.js",
      "default": "./dist/report.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run core:build && pnpm run cli:build && pnpm run web:build && pnpm run landing:build && pnpm run docs:build && pnpm run ext:build && pnpm run worker:build && pnpm run meta:build && pnpm run git:build",
    "typecheck": "turbo run typecheck //#ui:purity",
    "test": "vitest run",
    "parity": "vitest run tests/parity",
    "test:summary": "pnpm test 2>&1 | grep -E 'Test Files|Tests|Start at|Duration'",
    "//#test": "vitest run",
    "//#parity": "vitest run tests/parity",
    "core:build": "pnpm run report:build && pnpm --filter @i18nprune/core run build",
    "core:typecheck": "pnpm --filter @i18nprune/core typecheck",
    "cli:build": "tsup && pnpm run dts:fix && pnpm run report:build:assets",
    "cli:build:no-dts-fix": "tsup && pnpm run report:build:assets",
    "//#cli:build": "tsup && pnpm run dts:fix && pnpm run report:build:assets",
    "cli:dev": "tsx --tsconfig tsconfig.json packages/cli/bin/cli.ts",
    "cli:typecheck": "pnpm --filter @i18nprune/cli typecheck",
    "dts:fix": "node scripts/dts/fix-core-dts.mjs",
    "generate:languages": "tsx --tsconfig tsconfig.json scripts/catalog/run.ts",
    "prepack": "I18NPRUNE_PUBLISH=1 pnpm run cli:build",
    "versions:up": "tsx --tsconfig tsconfig.json scripts/release/sync.ts --up",
    "versions:sync": "tsx --tsconfig tsconfig.json scripts/release/sync.ts --sync",
    "versions:verify": "tsx --tsconfig tsconfig.json scripts/release/sync.ts --verify",
    "publish:verify": "node tests/publish-types/run.mjs",
    "publish:verify:fixture": "node tests/publish-types/run.mjs --skip-build --skip-pack",
    "ui:typecheck": "pnpm --filter @i18nprune/ui typecheck",
    "ui:purity": "node scripts/ui/purity-check.mjs",
    "//#ui:purity": "node scripts/ui/purity-check.mjs",
    "ui:sync:swagger-css": "node scripts/ui/sync-swagger-overrides.mjs",
    "ui:check:swagger-css": "node scripts/ui/sync-swagger-overrides.mjs && git diff --exit-code packages/ui/src/swagger/overrides-css.ts",
    "seo:build": "pnpm --filter @i18nprune/seo run build",
    "seo:sync:worker-public": "tsx scripts/seo/sync-worker-public.ts",
    "seo:typecheck": "pnpm --filter @i18nprune/seo typecheck",
    "docs:sync": "pnpm --filter @i18nprune/docs sync",
    "docs:sync:verify": "pnpm --filter @i18nprune/docs sync:verify",
    "docs:dev": "pnpm --filter @i18nprune/docs dev",
    "docs:build": "pnpm --filter @i18nprune/docs build",
    "docs:typecheck": "pnpm --filter @i18nprune/docs typecheck",
    "docs:deploy": "pnpm docs:build && wrangler pages deploy .vitepress/dist --project-name=docs-i18nprune --cwd apps/docs",
    "docs:descriptions": "node scripts/docs/add-descriptions.mjs",
    "web:dev": "pnpm --filter @i18nprune/web dev",
    "web:build": "pnpm --filter @i18nprune/web build",
    "web:typecheck": "pnpm --filter @i18nprune/web typecheck",
    "web:preview": "pnpm --filter @i18nprune/web preview",
    "web:deploy": "pnpm web:build && wrangler pages deploy dist --project-name=web-i18nprune --cwd apps/web",
    "landing:dev": "pnpm --filter @i18nprune/landing dev",
    "landing:build": "pnpm --filter @i18nprune/landing build",
    "landing:typecheck": "pnpm --filter @i18nprune/landing typecheck",
    "landing:deploy": "pnpm landing:build && wrangler pages deploy dist --cwd apps/landing",
    "report:dev": "pnpm --filter @i18nprune/report dev",
    "report:build": "pnpm --filter @i18nprune/report build",
    "report:typecheck": "pnpm --filter @i18nprune/report typecheck",
    "report:deploy": "pnpm report:build && wrangler pages deploy dist --project-name=report-i18nprune --cwd apps/report",
    "report:build:assets": "pnpm report:build && node scripts/report/build-assets.mjs",
    "releases:validate": "pnpm --filter @i18nprune/releases run validate",
    "releases:generate": "pnpm --filter @i18nprune/releases run generate:catalog",
    "releases:notes": "pnpm --filter @i18nprune/releases run github-release-body",
    "releases:build": "pnpm --filter @i18nprune/releases run build",
    "releases:typecheck": "pnpm --filter @i18nprune/releases typecheck",
    "releases:dev": "pnpm --filter @i18nprune/releases dev",
    "releases:deploy": "pnpm releases:build && wrangler pages deploy dist --project-name=releases-i18nprune --cwd apps/releases",
    "indexnow:ping": "tsx --tsconfig tsconfig.json scripts/indexnow/ping.mts",
    "indexnow:releases": "tsx --tsconfig tsconfig.json scripts/indexnow/ping.mts --preset releases",
    "indexnow:docs": "tsx --tsconfig tsconfig.json scripts/indexnow/ping.mts --preset docs",
    "indexnow:landing": "tsx --tsconfig tsconfig.json scripts/indexnow/ping.mts --preset landing",
    "indexnow:git": "tsx --tsconfig tsconfig.json scripts/indexnow/ping.mts --preset git",
    "git:sync": "pnpm --filter @i18nprune/git run sync",
    "git:sync:force": "pnpm --filter @i18nprune/git run sync:force",
    "git:validate": "pnpm --filter @i18nprune/git run validate",
    "git:build": "pnpm --filter @i18nprune/git run build",
    "git:typecheck": "pnpm --filter @i18nprune/git typecheck",
    "git:dev": "pnpm --filter @i18nprune/git dev",
    "git:deploy": "pnpm git:build && wrangler pages deploy dist --project-name=git-i18nprune --cwd apps/git",
    "meta:dev": "pnpm --filter @i18nprune/worker-meta dev",
    "meta:build": "pnpm --filter @i18nprune/worker-meta build",
    "meta:deploy": "pnpm meta:build && pnpm --filter @i18nprune/worker-meta run deploy",
    "worker:dev": "pnpm --filter @i18nprune/worker-i18nprune dev",
    "worker:build": "pnpm --filter @i18nprune/worker-i18nprune build",
    "worker:deploy": "pnpm worker:build && pnpm --filter @i18nprune/worker-i18nprune run deploy",
    "ext:compile": "pnpm --filter @i18nprune/extension compile",
    "ext:watch": "pnpm --filter @i18nprune/extension watch",
    "ext:build": "pnpm --filter @i18nprune/extension build",
    "ext:web:dev": "pnpm --filter @i18nprune/extension-webview dev",
    "ext:web:build": "pnpm --filter @i18nprune/extension-webview build",
    "ext:web:typecheck": "pnpm --filter @i18nprune/extension-webview typecheck",
    "ext:typecheck": "pnpm --filter @i18nprune/extension typecheck:host",
    "knip": "knip",
    "madge:circular": "node scripts/madge/run.mjs circular",
    "madge:orphans": "node scripts/madge/run.mjs orphans",
    "madge:leaves": "node scripts/madge/run.mjs leaves",
    "empty:dir": "find . -path '*node_modules' -prune -o -path '*/.wrangler' -prune -o -path ./.git -prune -o -type d -empty -print",
    "empty:file": "find . -path '*node_modules' -prune -o -path '*/.wrangler' -prune -o -path ./.git -prune -o -type f -empty -print",
    "empty:dir:del": "find . -type d -empty ! -path '*/node_modules' ! -path '*/node_modules/*' ! -path '*/.wrangler' ! -path '*/.wrangler/*' ! -path './.git' ! -path './.git/*' -print -delete",
    "empty:file:del": "find . -type f -empty ! -path '*/node_modules/*' ! -path '*/.wrangler/*' ! -path './.git/*' -print -delete"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "l10n",
    "translation",
    "locale",
    "json",
    "typescript",
    "cli",
    "sdk",
    "validate",
    "sync",
    "generate",
    "cleanup",
    "review",
    "quality",
    "doctor",
    "machine-translation",
    "translation-management",
    "vscode",
    "extension",
    "cloudflare-workers",
    "report",
    "share",
    "cache",
    "developer-tools",
    "ci",
    "i18nprune"
  ],
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.3.2",
    "jiti": "^2.6.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@expgov/cli": "^1.1.0",
    "@i18nprune/core": "workspace:*",
    "@i18nprune/seo": "workspace:*",
    "@inquirer/core": "^10.3.2",
    "@types/node": "^22.19.17",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "knip": "^6.12.0",
    "madge": "^8.0.0",
    "string-width": "^7.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "turbo": "^2.9.16",
    "typescript": "^5.9.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6",
    "wrangler": "^4.54.0"
  }
}
